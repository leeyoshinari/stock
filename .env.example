# The IP and port that the service listens on
host = 127.0.0.1
port = 15200

# run env, dev / test / prod
runEnv = prod

# Back-end url prefix
backEndPrefix = /stock

# Database, sqlite：sqlite+aiosqlite:///sqlite3.db
dbUrl = sqlite+aiosqlite:///sqlite3.db
connectionPoolSize = 20
# backup sqlite3.db
backupPath = /mnt

# query stock, single batch size
batchSize = 30

# batch interval, unit: second
batchInterval = 12

# access key
accessKey = 

# nextjs api server auto code
authCode = 12345

# Log level
logLevel = INFO

# Command Line
gunicornCmd = gunicorn

# QQ Email
senderEmail = 123456@qq.com
receiverEmail = 123456@qq.com
emailPassword = asdf

# openAI
openAIUrl = https://asdf.com
openAIModel = gpt-5
openAIKey = 12345

# distribute get stock info
HTTPHostCloud = https://asdf.com
HTTPHostVercel = https://asdf.com
HTTPHostNetlify = https://asdf.com

# longbridge run cmd url
longbridgeUrl = https://asdf.com

# tushare api key
tushareApiKey = 12345
